// عرض الملفات
function renderFiles(filter = 'all') {
  const container = document.getElementById('filesContainer');
  container.innerHTML = '';
  
  files.forEach((file, index) => {
    if (filter !== 'all' && file.category !== filter) return;
    
    const card = document.createElement('div');
    card.className = 'file-card';
    card.innerHTML = \`
      <div class="file-header">
        <span class="file-name">\${file.name}</span>
        <button class="btn-copy" onclick="copyFile(\${index}, this)">📋 نسخ</button>
      </div>
      <div class="file-content">\${file.content}</div>
    \`;
    container.appendChild(card);
  });
}

// نسخ المحتوى
function copyFile(index, btn) {
  const content = files[index].content;
  navigator.clipboard.writeText(content).then(() => {
    btn.textContent = '✅ تم النسخ!';
    btn.classList.add('copied');
    setTimeout(() => {
      btn.textContent = '📋 نسخ';
      btn.classList.remove('copied');
    }, 2000);
  }).catch(err => {
    alert('حدث خطأ في النسخ: ' + err);
  });
}

// فلترة الملفات
function filterFiles(category) {
  document.querySelectorAll('.filter button').forEach(btn => {
    btn.classList.remove('active');
  });
  event.target.classList.add('active');
  renderFiles(category);
}

// عرض الملفات عند تحميل الصفحة
renderFiles();
